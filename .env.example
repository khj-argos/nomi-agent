# ── Platform (Next.js) ───────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# openssl rand -base64 32
ENCRYPTION_KEY=

ORCHESTRATOR_SECRET=your-orchestrator-secret

NEXT_PUBLIC_APP_URL=https://your-domain.com

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_YEARLY_VARIANT_ID=

# ── Orchestrator (NestJS) ─────────────────────────────────────────────────────

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# Same raw value as ENCRYPTION_KEY but hex-encoded: openssl rand -hex 32
AES_SECRET_KEY=

WEBHOOK_BASE_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

CONTAINER_IDLE_TIMEOUT_MS=3600000
CONTAINER_STARTUP_TIMEOUT_MS=30000

# ── LLM proxy (dual backend: Ollama + Anthropic BYOK) ───────────────────────

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma4-agentic
ANTHROPIC_API_URL=https://api.anthropic.com

# openssl rand -hex 32 — signs internal tokens carried by agent containers
LLM_PROXY_INTERNAL_SECRET=
LLM_PROXY_TOKEN_TTL_SECONDS=86400

FREE_TIER_DAILY_TOKEN_LIMIT=100000
LLM_REQUEST_TIMEOUT_MS=600000
